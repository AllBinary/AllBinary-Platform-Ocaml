    <properties>
        <cygwin.home>G:/cygwin64</cygwin.home>
        <!-- ocamlopt builds native code with a .cmxa archive and ocamlc builds bytecode with a .cma archive -->
        <ocaml.compiler>ocamlopt</ocaml.compiler>
        <!-- -w +a-70 shows all warnings except missing-mli and -verbose shows the commands the compiler runs -->
        <ocaml.compiler.flags>-w +a-70 -verbose</ocaml.compiler.flags>
        <!-- Hand written Allbinary_java runtime module opened by all generated OCaml code -->
        <ocaml.runtime.source.path>G:/mnt/bc/mydev/workocaml/j2me/J2SEForOcamlLibraryOcamlM/src/main/java</ocaml.runtime.source.path>
        <!-- Set to false to continue the Maven build when the generated OCaml does not compile -->
        <ocaml.fail.on.error>true</ocaml.fail.on.error>
        <!-- Compiled OCaml modules of the dependencies in a directory per dependency -->
        <ocaml.dependency.directory>${project.build.directory}/ocaml-dependencies</ocaml.dependency.directory>
    </properties>

